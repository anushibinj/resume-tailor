%% Resume Tailor — how a tailoring run flows through the system.
%% Keep this in sync with code changes (see CLAUDE.md).
flowchart TB
    subgraph browser["Browser — Next.js 15 (:3000)"]
        settings["/settings<br/>model connections"]
        resumes["/resumes<br/>base resume library"]
        tailor["/tailor<br/>paste a posting"]
        runview["run detail<br/>diff · keywords · suggestions"]
    end

    subgraph api["Spring Boot (:8080)"]
        direction TB
        ctrl["Controllers<br/>/api/resumes · /api/runs · /api/llm-profiles"]
        owner{{"CurrentUserProvider<br/>every query is owner-scoped<br/>(v2 auth swaps only this)"}}

        subgraph ingest["Resume ingest"]
            detect["ResumeParser.detectFormat<br/>LaTeX or Markdown"]
            split["split at the begin-document marker<br/>preamble · body · tail"]
        end

        subgraph pipeline["TailoringRunner (async)"]
            analyse["1 · JdAnalyzer<br/>extract keywords + requirements<br/>cached per job description"]
            rewrite["2 · tailoring call<br/>reorder · reword · trim<br/>never invent"]
            match["3 · KeywordMatcher<br/>presence + weighted score<br/>computed in Java"]
        end

        rebuild["reassemble<br/>original preamble + tailored body"]
        splice["SuggestionSplicer<br/>applies only ACCEPTED suggestions"]
    end

    db[("Postgres<br/>resumes · job_descriptions<br/>tailoring_runs · run_keywords<br/>run_suggestions · llm_profiles")]
    llm["Your LLM<br/>OpenAI-compatible<br/>/chat/completions"]
    tex["docker run resume-tailor-tex<br/>--network none · -no-shell-escape<br/>memory + time capped"]

    settings --> ctrl
    resumes --> ctrl
    tailor --> ctrl
    ctrl --> owner
    owner --> db

    ctrl --> detect --> split --> db

    ctrl -- "POST /api/runs → 202 PENDING" --> pipeline
    analyse -- "call 1" --> llm
    rewrite -- "call 2 (body only,<br/>never the preamble)" --> llm
    analyse --> rewrite --> match --> db

    runview -- "poll every 2s until terminal" --> ctrl
    db --> rebuild --> splice --> runview
    splice -- "export PDF" --> tex --> runview

    classDef guard fill:#e4ecf5,stroke:#2f5d8c,color:#1d2b2f;
    classDef external fill:#f5efdf,stroke:#8a6d2b,color:#1d2b2f;
    class owner,match,splice guard;
    class llm,tex external;
