# ==============================================================================
# Resume Tailor — Docker Compose Environment Configuration
# ==============================================================================
# Copy this file to .env in the project root:
#   cp .env.example .env
#
# Docker Compose reads .env automatically when running:
#   docker compose up --build
# Or with a custom env file:
#   docker compose --env-file .env.custom up --build
# ==============================================================================

# ------------------------------------------------------------------------------
# Service Hostnames & Ports
# Customize these if you have port conflicts or custom networking on your machine.
# ------------------------------------------------------------------------------
# Service hostnames within the Docker Compose network (default: service names)
POSTGRES_HOST=postgres
BACKEND_HOST=backend
FRONTEND_HOST=frontend

# Ports published on your host machine and used by the respective services
FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=resume_tailor
POSTGRES_USER=resume_tailor
POSTGRES_PASSWORD=resume_tailor

# ------------------------------------------------------------------------------
# Required Backend Secrets & Auth
# ------------------------------------------------------------------------------
# REQUIRED. Base64-encoded 32 random bytes; encrypts stored LLM API keys (AES-256-GCM).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# REQUIRED for Google Sign-In. OAuth 2.0 Web client ID from Google Cloud Console:
#   APIs & Services > Credentials > OAuth client ID > Web application.
# Make sure your frontend host URL (e.g. http://localhost:3000 or http://localhost:<FRONTEND_PORT>)
# is listed under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# REQUIRED. Base64-encoded, at least 32 random bytes; signs app session JWT tokens.
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=1440

# ------------------------------------------------------------------------------
# Optional Overrides: Connection URLs (default automatically to hostnames & ports above)
# ------------------------------------------------------------------------------
# DATABASE_URL=jdbc:postgresql://postgres:5432/resume_tailor
# NEXT_PUBLIC_API_BASE_URL=http://backend:8080
# CORS_ALLOWED_ORIGINS=http://frontend:3000

# ------------------------------------------------------------------------------
# Optional: Initial LLM Profile Configuration
# Seeds a "Default" model profile for a new user's first sign-in.
# ------------------------------------------------------------------------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=8000
LLM_TIMEOUT_SECONDS=180

# Summary length slider character budget
SUMMARY_CHARS_PER_LINE=90

# ------------------------------------------------------------------------------
# PDF Compilation (requires Docker socket or prebuilt resume-tailor-tex image)
# ------------------------------------------------------------------------------
PDF_ENABLED=true
TEX_IMAGE=resume-tailor-tex
PDF_TIMEOUT_SECONDS=120
PDF_MEMORY_LIMIT=1g
PDF_CPU_LIMIT=2

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
