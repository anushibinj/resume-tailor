# Copy to backend/.env and fill in. backend/.env is gitignored.
# Loaded automatically by spring-dotenv when the backend starts.

SERVER_PORT=8080

# --- Database (docker compose up -d postgres) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/resume_tailor
DATABASE_USERNAME=resume_tailor
DATABASE_PASSWORD=resume_tailor

# --- Frontend origin allowed to call this API ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Secrets ---
# REQUIRED. Base64-encoded 32 random bytes; encrypts stored LLM API keys (AES-256-GCM).
# The backend refuses to start without it. Generate with:
#   openssl rand -base64 32
ENCRYPTION_KEY=

# --- Google Sign-In (auth; see CLAUDE.md) ---
# REQUIRED. OAuth 2.0 Web client ID from Google Cloud Console:
#   APIs & Services > Credentials > Create Credentials > OAuth client ID > Web application.
# Add both http://localhost:3000 (dev) and your deployed frontend origin as an
# "Authorized JavaScript origin" -- Google Identity Services rejects sign-in from any
# other origin. The frontend needs the same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# REQUIRED. Base64-encoded, at least 32 random bytes; signs the app's own session tokens
# issued after a Google sign-in is verified. The backend refuses to start without it.
# Generate with:
#   openssl rand -base64 48
JWT_SECRET=
# How long an issued session token is valid before signing in again is required.
JWT_EXPIRATION_MINUTES=1440

# --- Your LLM (any OpenAI-compatible /v1/chat/completions endpoint) ---
# These only seed a "Default" profile for a brand-new user's first sign-in; manage
# profiles in Settings afterwards.
# Examples:
#   OpenAI   LLM_BASE_URL=https://api.openai.com/v1          LLM_MODEL=gpt-4o-mini
#   Groq     LLM_BASE_URL=https://api.groq.com/openai/v1     LLM_MODEL=llama-3.3-70b-versatile
#   Ollama   LLM_BASE_URL=http://localhost:11434/v1          LLM_MODEL=llama3.1  (LLM_API_KEY=ollama)
#   LM Studio LLM_BASE_URL=http://localhost:1234/v1          LLM_MODEL=<loaded model>
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=8000
LLM_TIMEOUT_SECONDS=180

# --- Summary length slider ---
# Visible characters in one rendered line of your summary. The slider's "4 to 7 lines" is
# turned into a character budget with this, so set it to your template's text width: a wide
# single-column resume holds more per line than a narrow AltaCV column. It is an estimate --
# only compiling the PDF shows the real line count.
SUMMARY_CHARS_PER_LINE=90

# --- PDF compilation (requires Docker Desktop running) ---
# Build the image once:  docker build -t resume-tailor-tex docker/tex
# Set PDF_ENABLED=false to disable PDF export entirely (source download still works).
PDF_ENABLED=true
DOCKER_BINARY=docker
TEX_IMAGE=resume-tailor-tex
PDF_TIMEOUT_SECONDS=120
PDF_MEMORY_LIMIT=1g
PDF_CPU_LIMIT=2

# --- PDF storage ---
# Where compiled PDFs, and PDFs you upload for a run (e.g. one you converted from the
# exported .md yourself), are kept: "local" (a directory) or "s3".
STORAGE_TYPE=local
# Directory used by local storage. PDF_ARTIFACT_PATH, this setting's old name, is still
# read when this is unset.
STORAGE_LOCAL_PATH=./artifacts
# Largest PDF a user may upload for a run (Spring size syntax: 512KB, 10MB, ...).
UPLOAD_PDF_MAX_SIZE=10MB

# S3, or any S3-compatible server -- only read when STORAGE_TYPE=s3.
# S3_BUCKET is REQUIRED then; the backend refuses to start without it.
S3_BUCKET=
S3_REGION=us-east-1
# Blank for AWS. Set for MinIO (http://localhost:9000), Cloudflare R2, Backblaze B2, ...
S3_ENDPOINT=
# true for servers that don't support virtual-hosted buckets (MinIO).
S3_PATH_STYLE_ACCESS=false
# Leave both blank to use the AWS default credential chain (env vars, ~/.aws, IAM role).
# Set both or neither.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Prepended to every object key, so one bucket can hold more than this app.
S3_KEY_PREFIX=

# --- Misc ---
LOG_LEVEL=INFO
# Spring's multipart limits; the API itself has no multipart endpoints.
UPLOAD_MAX_FILE_SIZE=2MB
UPLOAD_MAX_REQUEST_SIZE=4MB
