# Copy to .env.local. Where the Spring Boot backend is listening.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Same OAuth 2.0 Web client ID as the backend's GOOGLE_CLIENT_ID (see backend/.env.example).
# Google Cloud Console must list this origin (http://localhost:3000 in dev) as an
# "Authorized JavaScript origin" or Google Identity Services refuses to sign in.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
