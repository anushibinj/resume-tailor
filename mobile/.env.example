# Copy to .env and run with:  flutter run --dart-define-from-file=.env
#
# Where the Spring Boot backend is listening, as seen from the phone. Left blank, the app
# uses http://10.0.2.2:8080 on the Android emulator (the host machine's localhost) and
# http://localhost:8080 everywhere else. A physical device needs the machine's LAN
# address, e.g. http://192.168.1.20:8080.
API_BASE_URL=

# The SAME OAuth 2.0 *Web* client ID as the backend's GOOGLE_CLIENT_ID. Passed to Google
# Sign-In as serverClientId so the ID token's audience is the one the backend verifies.
GOOGLE_SERVER_CLIENT_ID=

# iOS only: the OAuth 2.0 iOS client ID from the same Google Cloud project. Android needs
# no client ID here -- it is matched by package name + signing SHA-1 instead.
GOOGLE_IOS_CLIENT_ID=
